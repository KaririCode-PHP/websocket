{
    "name": "kariricode/websocket",
    "description": "RFC 6455 WebSocket server for PHP 8.4: strict frame parsing and handshake, closing handshake, connection pool, and kariricode/router integration.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "kariricode",
        "websocket",
        "rfc6455",
        "server",
        "realtime",
        "router"
    ],
    "homepage": "https://github.com/KaririCode-PHP/websocket",
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "walmir.silva@kariricode.org",
            "homepage": "https://kariricode.org",
            "role": "Lead Architect"
        }
    ],
    "support": {
        "issues": "https://github.com/KaririCode-PHP/websocket/issues",
        "source": "https://github.com/KaririCode-PHP/websocket",
        "security": "https://github.com/KaririCode-PHP/websocket/security/policy"
    },
    "require": {
        "php": "^8.4",
        "kariricode/exception": "^2.0.2",
        "kariricode/http": "^4.0",
        "kariricode/router": "^4.1"
    },
    "suggest": {
        "ext-openssl": "Integration\\TlsContext for servers that terminate TLS (wss://) themselves"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\WebSocket\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\WebSocket\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "kariricode": {
            "arfa": {
                "version": "1.3",
                "level": 1
            },
            "asvs": {
                "version": "5.0",
                "level": 1
            },
            "spec": "4.3.3",
            "error-code-range": "WS 1800–1899"
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "scripts": {
        "test": "kcode test",
        "test-unit": "kcode test --testsuite=unit",
        "test-conformance": "kcode test --testsuite=conformance",
        "phpstan": "kcode run phpstan analyse --no-progress --memory-limit=1G",
        "psalm": "kcode run psalm --no-cache",
        "complexity": "@php tools/complexity.php src",
        "mutation": [
            "Composer\\Config::disableProcessTimeout",
            "kcode run infection --threads=max --no-progress --show-mutations"
        ],
        "security": [
            "@composer audit --locked",
            "@composer audit --locked --working-dir=.kcode",
            "@php tools/secret-scan.php"
        ],
        "sbom": "@php tools/sbom.php sbom.cdx.json",
        "cs-check": "kcode cs:fix --check",
        "cs-fix": "kcode cs:fix",
        "check": [
            "@cs-check",
            "@phpstan",
            "@psalm",
            "@complexity",
            "@test",
            "@mutation"
        ]
    },
    "scripts-descriptions": {
        "test": "All suites (unit, conformance)",
        "phpstan": "PHPStan at level max",
        "psalm": "Psalm at errorLevel 1",
        "complexity": "Spec V4.3.3 §13 budgets: cyclomatic, nesting, parameters",
        "mutation": "Infection, MSI and covered MSI >= 80",
        "security": "composer audit of the runtime and the toolchain, and a secret scan",
        "sbom": "CycloneDX 1.5 SBOM from composer.lock",
        "check": "Every gate CI runs, in order"
    }
}
