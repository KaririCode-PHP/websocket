{
    "name": "kariricode/websocket",
    "description": "RFC 6455 compliant WebSocket server with ARFA 1.3 architecture and Router V4.1 integration",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "kariricode/router": "^4.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\WebSocket\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\WebSocket\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "arfa": {
            "level": 2,
            "version": "1.3"
        }
    }
}